{#
  Shared layout for the form-plugin landing pages (Contact Form 7, Ninja Forms, Gravity Forms).
  Set `fp` before including. Fields:
    name        plugin name, e.g. "Contact Form 7"
    heroSub     one sentence under the H1
    whyTitle    heading for the "why you still get spam" section
    why         list of paragraphs (HTML allowed)
    builtins    list of { name, text }: the plugin's own anti-spam options and their gap
    blocked     what happens to a blocked submission in this plugin (HTML allowed)
    mock        { field, value, reason } for the hero illustration
    guides      list of { title, url, image }
    faqs        list of { q, a } (HTML allowed in a); turned into FAQPage data by the build
  Shared copy (features, comparison, reviews, pricing) lives here so all pages stay in sync.
#}
<style>
  .fp { --cream: #FBF6ED; --yellow: #FCDD56; --green: #166239; --line: rgba(0,0,0,.12); overflow-x: clip; }
  .fp p, .fp li, .fp td, .fp th, .fp summary { font-family: 'Open Sans Regular', 'Open Sans', sans-serif; color: #000; }
  .fp .fp-wrap { max-width: 1120px; margin: 0 auto; padding: 0 24px; }
  .fp section.fp-sec { padding: 88px 0; }
  .fp .eyebrow { font-family: 'Open Sans Bold', sans-serif; font-size: 13px; letter-spacing: .12em; text-transform: uppercase; color: #555; margin: 0 0 14px; }
  .fp h2.fp-h2 { font-size: 44px !important; line-height: 1.1 !important; margin: 0 0 18px; color: #000; }
  .fp h3.fp-h3 { font-size: 21px !important; line-height: 1.25 !important; margin: 0 0 8px; color: #000; }
  .fp .lead { font-size: 19px; line-height: 1.65; max-width: 62ch; }
  .fp .center { text-align: center; }
  .fp .center .lead { margin-left: auto; margin-right: auto; }
  .fp a.text-link { color: #000; background-image: none; box-shadow: inset 0 -6px 0 var(--yellow); }
  .fp a.text-link:hover { box-shadow: inset 0 -12px 0 var(--yellow); }
  .fp .btn { display: inline-flex; align-items: center; gap: .4rem; padding: 14px 26px; border: 1.5px solid #000; border-radius: 999px; font-family: 'Open Sans SemiBold', sans-serif; font-size: 17px; color: #000; background-image: none; transition: transform .15s, box-shadow .15s; }
  .fp .btn-primary { background: var(--yellow); box-shadow: 3px 4px 0 #000; }
  .fp .btn-primary:hover { transform: translate(-1px, -1px); box-shadow: 4px 5px 0 #000; }
  .fp .btn-ghost { background: #fff; }
  .fp .btn-ghost:hover { background: var(--cream); }
  .fp .btn-row { display: flex; flex-wrap: wrap; gap: 14px; }

  /* Hero */
  .fp .fp-hero { background: var(--cream); padding: 80px 0 72px; border-bottom: 1px solid #000; }
  .fp .hero-grid { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, .9fr); gap: 56px; align-items: center; }
  .fp .fp-hero h1 { font-size: 58px !important; line-height: 1.05 !important; letter-spacing: -.02em; margin: 0 0 22px; color: #000; }
  .fp .fp-hero .lead { margin: 0 0 28px; }
  .fp .trust { display: flex; flex-wrap: wrap; gap: 8px 22px; margin: 26px 0 0; padding: 0; list-style: none; }
  .fp .trust li { font-family: 'Open Sans SemiBold', sans-serif; font-size: 15px; margin: 0; }
  .fp .trust .stars { color: #000; letter-spacing: 1px; }

  /* Hero illustration: one spam blocked, one real message delivered */
  .fp .mock-stack { display: grid; gap: 18px; }
  .fp .mock { background: #fff; border: 1.5px solid #000; border-radius: 16px; padding: 18px 20px; }
  .fp .mock-spam { box-shadow: 8px 9px 0 var(--yellow); }
  .fp .mock-ok { margin-left: 40px; }
  .fp .mock-top { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin: 0 0 10px; }
  .fp .mock-top p { margin: 0; font-family: 'Open Sans SemiBold', sans-serif; font-size: 14px; color: #555; }
  .fp .badge { display: inline-block; padding: 3px 12px; border-radius: 999px; font-family: 'Open Sans Bold', sans-serif; font-size: 12px; letter-spacing: .04em; border: 1px solid #000; white-space: nowrap; }
  .fp .badge-spam { background: #FEE5E5; }
  .fp .badge-ok { background: #DDF3EA; }
  .fp .mock-msg { margin: 0; font-size: 16px; line-height: 1.5; }
  .fp .mock-why { margin: 10px 0 0; font-size: 13px; color: #555; }

  /* Why */
  .fp .why-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 56px; align-items: start; }
  .fp .why-grid .body p:not(.eyebrow) { font-size: 18px; line-height: 1.75; margin: 0 0 16px; }
  .fp .builtins { list-style: none; margin: 0; padding: 0; border: 1.5px solid #000; border-radius: 16px; overflow: hidden; background: #fff; }
  .fp .builtins li { margin: 0; padding: 18px 22px; border-bottom: 1px solid var(--line); }
  .fp .builtins li:last-child { border-bottom: 0; }
  .fp .builtins .b-name { font-family: 'Open Sans Bold', sans-serif; font-size: 16px; margin: 0 0 4px; }
  .fp .builtins .b-text { font-size: 15px; line-height: 1.55; margin: 0; color: #333; }
  .fp .builtins-title { font-family: 'Open Sans Bold', sans-serif; font-size: 13px; letter-spacing: .1em; text-transform: uppercase; color: #555; margin: 0; padding: 14px 22px; background: var(--cream); border-bottom: 1px solid #000; }

  /* Steps */
  .fp .fp-steps { background: linear-gradient(180deg, #E9D9C8 0%, #FEE5E5 100%); border-top: 1px solid #000; border-bottom: 1px solid #000; }
  .fp .steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin: 40px 0 0; padding: 0; list-style: none; counter-reset: step; }
  .fp .steps li { margin: 0; background: #fff; border: 1.5px solid #000; border-radius: 16px; padding: 26px; counter-increment: step; }
  .fp .steps li::before { content: counter(step); display: inline-flex; align-items: center; justify-content: center; width: 38px; height: 38px; border-radius: 50%; background: var(--yellow); border: 1.5px solid #000; font-family: 'Bricolage Grotesque', sans-serif; font-size: 18px; margin-bottom: 14px; }
  .fp .steps p { font-size: 16px; line-height: 1.6; margin: 0; }
  .fp .blocked { margin: 28px 0 0; padding: 20px 24px; background: #fff; border: 1.5px solid #000; border-radius: 16px; }
  .fp .blocked p { margin: 0; font-size: 16px; line-height: 1.65; }

  /* Features */
  .fp .features { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: 40px; }
  .fp .feature { border: 1.5px solid #000; border-radius: 16px; padding: 24px; background: #fff; }
  .fp .feature p { font-size: 15.5px; line-height: 1.6; margin: 0; }
  .fp .feature .f-icon { width: 44px; height: 44px; border-radius: 12px; background: #fff; border: 1.5px solid #000; display: flex; align-items: center; justify-content: center; margin-bottom: 14px; }
  .fp .feature .f-icon svg { width: 24px; height: 24px; overflow: visible; }
  .fp .feature .f-icon svg * { fill: none; stroke: #000; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  .fp .feature .f-icon svg .acc { fill: #FCDD56; }
  .fp .shot { margin: 48px auto 0; max-width: 900px; }
  .fp .shot img { display: block; width: 100%; height: auto; border: 1.5px solid #000; border-radius: 14px; box-shadow: 6px 7px 0 var(--yellow); }
  .fp .shot figcaption { font-size: 14px; color: #555; text-align: center; margin-top: 14px; font-family: 'Open Sans Regular', sans-serif; }

  /* Comparison */
  .fp .fp-compare { background: var(--cream); border-top: 1px solid #000; border-bottom: 1px solid #000; }
  .fp .table-scroll { overflow-x: auto; margin-top: 36px; border: 1.5px solid #000; border-radius: 16px; background: #fff; }
  .fp table.cmp { width: 100%; border-collapse: collapse; min-width: 640px; }
  .fp table.cmp th, .fp table.cmp td { padding: 14px 16px; border-bottom: 1px solid var(--line); text-align: center; font-size: 15px; line-height: 1.4; vertical-align: middle; }
  .fp table.cmp th { font-family: 'Open Sans Bold', sans-serif; background: #fff; }
  .fp table.cmp th:first-child, .fp table.cmp td:first-child { text-align: left; }
  .fp table.cmp tr:last-child td { border-bottom: 0; }
  .fp table.cmp .us { background: #FFF8D6; }
  .fp table.cmp th.us { background: var(--yellow); }
  .fp .yes { font-family: 'Open Sans Bold', sans-serif; color: var(--green) !important; }
  .fp .no { color: #999 !important; }
  .fp .part { color: #555 !important; }
  .fp .swipe-hint { display: none; font-size: 13px; color: #555; margin: 24px 0 -24px; }
  @media (max-width: 768px) { .fp .swipe-hint { display: block; } }
  .fp .cmp-note { font-size: 14px; color: #555; margin: 14px 0 0; }

  /* Reviews */
  .fp .rating { display: inline-flex; align-items: center; gap: 10px; padding: 8px 18px; border: 1px solid #000; border-radius: 999px; background: #fff; margin: 4px 0 0; font-family: 'Open Sans SemiBold', sans-serif; font-size: 15px; color: #000; background-image: none; }
  .fp .reviews { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: 36px; }
  .fp .review { margin: 0; padding: 26px; border-radius: 16px; background-image: linear-gradient(0deg, #000 0%, #000 50%, #166239 100%); display: flex; flex-direction: column; justify-content: space-between; gap: 18px; }
  .fp .review p { color: #fff !important; font-size: 16.5px; line-height: 1.6; margin: 0; }
  .fp .review cite { font-style: normal; font-family: 'Open Sans SemiBold', sans-serif; font-size: 14px; color: var(--yellow); }
  .fp .review cite a { color: var(--yellow); background-image: none; text-decoration: underline; }

  /* Guides */
  .fp .guides { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-top: 36px; }
  .fp a.guide { display: flex; flex-direction: column; border: 1.5px solid #000; border-radius: 14px; overflow: hidden; background: #fff; color: #000; background-image: none; transition: transform .15s, box-shadow .15s; }
  .fp a.guide:hover { transform: translateY(-2px); box-shadow: 4px 5px 0 var(--yellow); }
  .fp a.guide img { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; border-bottom: 1px solid #000; background: var(--cream); display: block; }
  .fp a.guide p { margin: 0; padding: 14px 16px 18px; font-family: 'Open Sans SemiBold', sans-serif; font-size: 15px; line-height: 1.4; }

  /* FAQ */
  .fp #faq { padding: 88px 0; }
  .fp .faq { max-width: 820px; margin: 36px auto 0; border-top: 1px solid #000; }
  .fp .faq details { border-bottom: 1px solid #000; }
  .fp .faq summary { list-style: none; cursor: pointer; padding: 20px 44px 20px 0; position: relative; font-family: 'Open Sans SemiBold', sans-serif; font-size: 18px; line-height: 1.4; }
  .fp .faq summary::-webkit-details-marker { display: none; }
  .fp .faq summary::after { content: "+"; position: absolute; right: 6px; top: 50%; transform: translateY(-50%); font-family: 'Bricolage Grotesque', sans-serif; font-size: 26px; }
  .fp .faq details[open] summary::after { content: "–"; }
  .fp .faq .a { padding: 0 0 22px; }
  .fp .faq .a p { font-size: 16.5px; line-height: 1.7; margin: 0; max-width: 70ch; }

  /* Final CTA */
  .fp .fp-cta { background: var(--yellow); border-top: 1px solid #000; text-align: center; }
  .fp .fp-cta .btn-row { justify-content: center; }
  .fp .fp-cta .btn-primary { background: #fff; }

  @media (max-width: 1023px) {
    .fp .hero-grid, .fp .why-grid { grid-template-columns: 1fr; gap: 40px; }
    .fp .mock-ok { margin-left: 24px; }
    .fp .features, .fp .reviews { grid-template-columns: 1fr 1fr; }
    .fp .guides { grid-template-columns: 1fr 1fr; }
    .fp .steps { grid-template-columns: 1fr; }
  }
  @media (max-width: 768px) {
    .fp section.fp-sec, .fp #faq { padding: 64px 0; }
    .fp .fp-hero { padding: 56px 0; }
    .fp .fp-hero h1 { font-size: 38px !important; }
    .fp h2.fp-h2 { font-size: 32px !important; }
    .fp .lead { font-size: 17px; }
    .fp .features, .fp .reviews, .fp .guides { grid-template-columns: 1fr; }
    .fp .btn-row .btn { width: 100%; justify-content: center; }
  }
</style>

<main class="fp">

  <!-- Hero -->
  <section class="fp-hero">
    <div class="fp-wrap hero-grid">
      <div>
        <p class="eyebrow">{{ fp.name }} spam filter</p>
        <h1>Stop {{ fp.name }} spam without a CAPTCHA</h1>
        <p class="lead">{{ fp.heroSub | safe }}</p>
        <div class="btn-row">
          <a class="btn btn-primary" href="https://wordpress.org/plugins/oopspam-anti-spam/">Install the free plugin →</a>
          <a class="btn btn-ghost" href="#how-it-works">See how it works</a>
        </div>
        <ul class="trust" aria-label="Why people trust oopspam">
          <li><a class="text-link" href="https://wordpress.org/support/plugin/oopspam-anti-spam/reviews/"><span class="stars" aria-hidden="true">★★★★★</span> 4.9 on WordPress.org</a></li>
          <li>6,000+ active installs</li>
          <li>3.5M+ websites protected</li>
        </ul>
      </div>
      <div>
        <div class="mock-stack" role="img" aria-label="Illustration: oopspam blocks a spam {{ fp.name }} submission and delivers a real one">
          <div class="mock mock-spam">
            <div class="mock-top"><p>{{ fp.name }} submission</p><span class="badge badge-spam">Spam blocked</span></div>
            <p class="mock-msg">{{ fp.mock.value }}</p>
            <p class="mock-why">{{ fp.mock.reason }}</p>
          </div>
          <div class="mock mock-ok">
            <div class="mock-top"><p>{{ fp.name }} submission</p><span class="badge badge-ok">Delivered</span></div>
            <p class="mock-msg">Hi, could you send me a quote for a website redesign? We're a team of 12.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Why -->
  <section class="fp-sec">
    <div class="fp-wrap why-grid">
      <div class="body">
        <p class="eyebrow">The problem</p>
        <h2 class="fp-h2">{{ fp.whyTitle }}</h2>
        {% for p in fp.why %}<p>{{ p | safe }}</p>{% endfor %}
      </div>
      <ul class="builtins" aria-label="{{ fp.name }}'s own anti-spam options">
        <li class="builtins-title">What {{ fp.name }} offers on its own</li>
        {% for b in fp.builtins %}
        <li><p class="b-name">{{ b.name }}</p><p class="b-text">{{ b.text | safe }}</p></li>
        {% endfor %}
      </ul>
    </div>
  </section>

  <!-- How it works -->
  <section class="fp-sec fp-steps" id="how-it-works">
    <div class="fp-wrap">
      <p class="eyebrow">How it works</p>
      <h2 class="fp-h2">Set up in about five minutes</h2>
      <p class="lead">No changes to your forms, and nothing for your visitors to solve.</p>
      <ol class="steps">
        <li><h3 class="fp-h3">Install the plugin</h3><p>In WordPress, go to <strong>Plugins → Add New</strong>, search for “oopspam Anti-Spam”, then install and activate it.</p></li>
        <li><h3 class="fp-h3">Add your API key</h3><p><a class="text-link" href="https://app.oopspam.com/Identity/Account/Register">Create a free account</a>, copy your API key and paste it under <strong>Settings → oopspam Anti-Spam</strong>.</p></li>
        <li><h3 class="fp-h3">Turn on {{ fp.name }}</h3><p>In the {{ fp.name }} section of the settings, switch on <strong>Activate Spam Protection</strong> and write the message spammers will see. That's it.</p></li>
      </ol>
      <div class="blocked">
        <p><strong>What happens to a blocked submission?</strong> {{ fp.blocked | safe }}</p>
      </div>
    </div>
  </section>

  <!-- Features -->
  <section class="fp-sec">
    <div class="fp-wrap">
      <p class="eyebrow">Features</p>
      <h2 class="fp-h2">Everything you need to keep {{ fp.name }} clean</h2>
      <div class="features">
        <div class="feature">
          <div class="f-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><circle class="acc" cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1.2"/></svg></div>
          <h3 class="fp-h3">99.9% accurate detection</h3>
          <p>Machine learning reads each message and checks the sender's IP and email against a blocklist of 350M+ known spammers. It catches bots and people paid to spam.</p>
        </div>
        <div class="feature">
          <div class="f-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="13" rx="2"/><path d="M8 21h8M12 17v4"/><path class="acc" d="M8 9.5h8v3H8z"/></svg></div>
          <h3 class="fp-h3">Context-aware checks</h3>
          <p>oopspam can judge a message against what your website is for, so off-topic pitches that look human get caught too.</p>
        </div>
        <div class="feature">
          <div class="f-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><circle class="acc" cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c3 3.5 3 14.5 0 18M12 3c-3 3.5-3 14.5 0 18"/></svg></div>
          <h3 class="fp-h3">Country and language filters</h3>
          <p>Accept submissions only from the countries and languages you serve, and always trust the ones you choose.</p>
        </div>
        <div class="feature">
          <div class="f-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><rect class="acc" x="4" y="10" width="16" height="10" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/><path d="M12 14v2"/></svg></div>
          <h3 class="fp-h3">VPN, proxy and disposable email blocking</h3>
          <p>Block submissions from VPNs and cloud providers, and from throwaway email addresses that spammers use once.</p>
        </div>
        <div class="feature">
          <div class="f-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><circle class="acc" cx="12" cy="13" r="8"/><path d="M12 9v4l3 2M9 2h6"/></svg></div>
          <h3 class="fp-h3">Rate limiting</h3>
          <p>Cap how many times one IP address or email can submit per hour, so floods stop before they reach you.</p>
        </div>
        <div class="feature">
          <div class="f-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path class="acc" d="M6 3h9l4 4v14H6z"/><path d="M15 3v4h4M9 11h7M9 15h7"/></svg></div>
          <h3 class="fp-h3">Logs that explain every decision</h3>
          <p>Spam and valid entries are kept in your own WordPress database, with the reason each one was blocked. Get email alerts and a spam summary report.</p>
        </div>
        <div class="feature">
          <div class="f-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 6h16M4 12h9M4 18h6"/><circle class="acc" cx="17.5" cy="16.5" r="4"/><path d="M15.5 14.5l4 4M19.5 14.5l-4 4"/></svg></div>
          <h3 class="fp-h3">Your own block lists</h3>
          <p>Block specific keywords, emails, IP addresses and IP ranges, or messages that contain links.</p>
        </div>
        <div class="feature">
          <div class="f-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path class="acc" d="M12 12c-2-3-4.5-4-6.5-4a4 4 0 0 0 0 8c2 0 4.5-1 6.5-4zm0 0c2 3 4.5 4 6.5 4a4 4 0 0 0 0-8c-2 0-4.5 1-6.5 4z"/></svg></div>
          <h3 class="fp-h3">One API key, unlimited websites</h3>
          <p>You pay for spam checks, not per site. Use the same key on every WordPress site you manage.</p>
        </div>
        <div class="feature">
          <div class="f-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path class="acc" d="M12 3l8 3v6c0 4.5-3.4 8.2-8 9-4.6-.8-8-4.5-8-9V6z"/><path d="M9 12l2 2 4-4"/></svg></div>
          <h3 class="fp-h3">Private by default</h3>
          <p>Nothing is stored on our servers unless you turn on remote logging. You can switch off checks that use personal data, and we're GDPR compliant.</p>
        </div>
      </div>
      <figure class="shot">
        <img loading="lazy" src="/assets/WP_SensitivyLevel.jpg" alt="oopspam Anti-Spam plugin settings in WordPress, showing usage, the API key field and the sensitivity level slider" width="1200" height="660">
        <figcaption>The plugin's settings in WordPress, with the sensitivity level slider.</figcaption>
      </figure>
    </div>
  </section>

  <!-- Comparison -->
  <section class="fp-sec fp-compare">
    <div class="fp-wrap">
      <p class="eyebrow">Compare</p>
      <h2 class="fp-h2">oopspam vs the usual {{ fp.name }} fixes</h2>
      <p class="swipe-hint" aria-hidden="true">Swipe to compare →</p>
      <div class="table-scroll">
        <table class="cmp">
          <thead>
            <tr><th scope="col">What you get</th><th scope="col" class="us">oopspam</th><th scope="col">reCAPTCHA</th><th scope="col">Honeypot</th><th scope="col">Akismet</th></tr>
          </thead>
          <tbody>
            <tr><td>Stops automated bots</td><td class="us yes">Yes</td><td class="yes">Yes</td><td class="part">Simple bots only</td><td class="yes">Yes</td></tr>
            <tr><td>Stops spam typed by real people</td><td class="us yes">Yes</td><td class="no">No</td><td class="no">No</td><td class="part">Partly</td></tr>
            <tr><td>No challenge for visitors</td><td class="us yes">Yes</td><td class="part">v3 only</td><td class="yes">Yes</td><td class="yes">Yes</td></tr>
            <tr><td>No third-party script on your pages</td><td class="us yes">Yes</td><td class="no">No</td><td class="yes">Yes</td><td class="yes">Yes</td></tr>
            <tr><td>Country, language and VPN filters</td><td class="us yes">Yes</td><td class="no">No</td><td class="no">No</td><td class="no">No</td></tr>
            <tr><td>Shows why a submission was blocked</td><td class="us yes">Yes</td><td class="no">No</td><td class="no">No</td><td class="no">No</td></tr>
          </tbody>
        </table>
      </div>
      <p class="cmp-note">You don't have to choose: oopspam works alongside reCAPTCHA or a honeypot if you want to keep them.</p>
    </div>
  </section>

  <!-- Reviews -->
  <section class="fp-sec">
    <div class="fp-wrap center">
      <p class="eyebrow">Reviews</p>
      <h2 class="fp-h2">What site owners say</h2>
      <a class="rating" href="https://wordpress.org/support/plugin/oopspam-anti-spam/reviews/"><span aria-hidden="true">★★★★★</span> 4.9 out of 5 from 51 reviews on WordPress.org</a>
      <div class="reviews" style="text-align:left">
        <blockquote class="review">
          <p>“I'm very happy with the usable data and tools provided to me. It's eliminated all spam, and even the need for Captcha.”</p>
          <cite><a href="https://wordpress.org/support/topic/very-solid-spam-control/">@gotmick on WordPress.org</a></cite>
        </blockquote>
        <blockquote class="review">
          <p>“We tried various methods including but not limited to Captcha, Honeypot… We strongly recommend oopspam for anyone who values their time and resources.”</p>
          <cite>Vu Nguyen, Nilead.com</cite>
        </blockquote>
        <blockquote class="review">
          <p>“Pricing is perfect for agencies as they do tiers by actual # of API calls and no limit on the number of sites you can install this on.”</p>
          <cite><a href="https://wordpress.org/support/topic/great-service-438/">@squarecandy on WordPress.org</a></cite>
        </blockquote>
      </div>
    </div>
  </section>

  <!-- Pricing -->
  {% set pricingIncludes = ["Unlimited websites", "Works with " + fp.name + " and 40+ other WordPress form plugins", "Context-aware spam detection", "Country, language, VPN and rate-limit filters", "No logs by default", "API key rotation"] %}
  {% include "partials/pricing.njk" %}

  <!-- Guides -->
  <section class="fp-sec">
    <div class="fp-wrap">
      <p class="eyebrow">Guides</p>
      <h2 class="fp-h2">{{ fp.name }} spam guides</h2>
      <div class="guides">
        {% for g in fp.guides %}
        <a class="guide" href="{{ g.url }}"><img loading="lazy" src="{{ g.image }}" alt="" width="400" height="225"><p>{{ g.title }}</p></a>
        {% endfor %}
      </div>
    </div>
  </section>

  <!-- FAQ (FAQPage data is added by the build from these <details>) -->
  <section id="faq" style="background: var(--cream); border-top: 1px solid #000;">
    <div class="fp-wrap">
      <p class="eyebrow center">FAQ</p>
      <h2 class="fp-h2 center">{{ fp.name }} spam: common questions</h2>
      <div class="faq">
        {% for f in fp.faqs %}
        <details><summary>{{ f.q }}</summary><div class="a"><p>{{ f.a | safe }}</p></div></details>
        {% endfor %}
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="fp-sec fp-cta">
    <div class="fp-wrap">
      <h2 class="fp-h2">Your {{ fp.name }} inbox, minus the spam</h2>
      <p class="lead" style="margin: 0 auto 28px">Start with 40 free spam checks a month. No credit card required.</p>
      <div class="btn-row">
        <a class="btn btn-primary" href="https://wordpress.org/plugins/oopspam-anti-spam/">Install the free plugin →</a>
        <a class="btn btn-ghost" href="https://app.oopspam.com/Identity/Account/Register">Get your API key</a>
      </div>
    </div>
  </section>

</main>
